# Optional CARL configuration. AWS credentials are normally supplied by AWS SSO
# or your configured AWS profile rather than stored in this file.
AWS_PROFILE=<your-aws-profile>
AWS_DEFAULT_PROFILE=<your-aws-profile>
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2

# Optional model and service overrides.
# CARL_MODEL=<bedrock-model-id>
# CARL_REPORT_MODEL=<bedrock-model-id>
# CARL_TRILLIAN_MODEL=<bedrock-model-id>
# CARL_PERSONA_UPDATE_MODEL=<bedrock-model-id>
# SEMANTIC_SCHOLAR_API_KEY=<optional-key>
# OPENALEX_CONTACT_EMAIL=<optional-contact-email>
# CARL_PORT=5001
